    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Run DijkstrasAlgorithm (release)",
    "command": "./build-release/DijkstrasAlgorithm.exe",
